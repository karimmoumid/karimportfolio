{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau projet{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('admin_projects') }}">Projets</a></li>
    <li class="breadcrumb-item active">Nouveau</li>
{% endblock %}

{% block admin_content %}
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-plus text-primary me-2"></i>
                        Créer un nouveau projet
                    </h5>
                </div>

                <div class="card-body">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                {{ form_row(form.title) }}
                            </div>

                            <div class="mb-3">
                                {{ form_row(form.description) }}
                            </div>

                            <div class="mb-4">
                                {{ form_row(form.fullDescription) }}
                            </div>

                            <!-- Section Galerie d'images -->
                            <div class="gallery-section bg-light p-3 rounded mb-4">
                                <h6 class="mb-3">
                                    <i class="fas fa-images me-2"></i>Galerie d'images
                                </h6>

                                <div class="mb-3">
                                    {{ form_label(form.galleryImagesFiles) }}
                                    {{ form_widget(form.galleryImagesFiles, {'attr': {'class': 'form-control', 'accept': 'image/*', 'multiple': 'multiple'}}) }}
                                    {{ form_help(form.galleryImagesFiles) }}
                                </div>

                                <div class="gallery-preview" id="galleryPreview" style="display: none;">
                                    <h6 class="text-muted mb-2">Aperçu de la galerie</h6>
                                    <div class="gallery-grid" id="galleryGrid"></div>
                                </div>

                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Vous pouvez sélectionner plusieurs images (Ctrl+Click ou Cmd+Click)
                                </small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <!-- Section Image Principale -->
                            <div class="project-sidebar bg-light p-3 rounded mb-3">
                                <h6 class="mb-3">
                                    <i class="fas fa-image me-2"></i>Image principale
                                </h6>

                                <div class="mb-3">
                                    {{ form_label(form.imageFile) }}
                                    {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                                    {{ form_help(form.imageFile) }}
                                </div>

                                <div class="image-preview mb-3" id="mainImagePreview" style="display: none;">
                                    <img id="mainPreviewImg" class="img-fluid rounded" alt="Aperçu principal">
                                </div>

                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Image qui sera affichée en aperçu
                                </small>
                            </div>

                            <!-- Compteur d'images -->
                            <div class="images-counter bg-info bg-opacity-10 p-3 rounded text-center">
                                <div class="d-flex justify-content-around">
                                    <div>
                                        <i class="fas fa-image text-primary"></i>
                                        <p class="mb-0 small">Image principale</p>
                                        <span id="mainImageCount" class="badge bg-primary">0</span>
                                    </div>
                                    <div>
                                        <i class="fas fa-images text-info"></i>
                                        <p class="mb-0 small">Galerie</p>
                                        <span id="galleryImageCount" class="badge bg-info">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="skills-section">
                                <h6 class="mb-3">
                                    <i class="fas fa-star me-2"></i>Technologies utilisées
                                </h6>
                                {{ form_row(form.skill) }}
                            </div>
                        </div>
                    </div>

                    <div class="form-actions d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a href="{{ path('admin_projects') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Annuler
                        </a>

                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-primary" onclick="previewProject()">
                                <i class="fas fa-eye me-2"></i>Aperçu
                            </button>
                            {{ form_row(form.submit, {'attr': {'class': 'btn btn-success'}}) }}
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Preview image principale
            const mainImageInput = document.querySelector('#project_mainImageFile');
            const mainImagePreview = document.getElementById('mainImagePreview');
            const mainPreviewImg = document.getElementById('mainPreviewImg');
            const mainImageCount = document.getElementById('mainImageCount');

            if (mainImageInput) {
                mainImageInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            mainPreviewImg.src = e.target.result;
                            mainImagePreview.style.display = 'block';
                            mainImageCount.textContent = '1';
                            mainImageCount.classList.remove('bg-primary');
                            mainImageCount.classList.add('bg-success');
                        };
                        reader.readAsDataURL(file);
                    } else {
                        mainImagePreview.style.display = 'none';
                        mainImageCount.textContent = '0';
                        mainImageCount.classList.remove('bg-success');
                        mainImageCount.classList.add('bg-primary');
                    }
                });
            }

            // Preview galerie d'images
            const galleryInput = document.querySelector('#project_galleryImagesFiles');
            const galleryPreview = document.getElementById('galleryPreview');
            const galleryGrid = document.getElementById('galleryGrid');
            const galleryImageCount = document.getElementById('galleryImageCount');

            if (galleryInput) {
                galleryInput.addEventListener('change', function(e) {
                    const files = e.target.files;
                    galleryGrid.innerHTML = '';

                    if (files.length > 0) {
                        galleryPreview.style.display = 'block';
                        galleryImageCount.textContent = files.length;
                        galleryImageCount.classList.remove('bg-info');
                        galleryImageCount.classList.add('bg-success');

                        Array.from(files).forEach((file, index) => {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                const imgContainer = document.createElement('div');
                                imgContainer.className = 'gallery-item';
                                imgContainer.innerHTML = `
                                    <img src="${e.target.result}" alt="Image ${index + 1}">
                                    <div class="gallery-item-overlay">
                                        <span class="badge bg-dark">${index + 1}</span>
                                        <small>${formatFileSize(file.size)}</small>
                                    </div>
                                `;
                                galleryGrid.appendChild(imgContainer);
                            };
                            reader.readAsDataURL(file);
                        });
                    } else {
                        galleryPreview.style.display = 'none';
                        galleryImageCount.textContent = '0';
                        galleryImageCount.classList.remove('bg-success');
                        galleryImageCount.classList.add('bg-info');
                    }
                });
            }
        });

        // Fonction pour formater la taille du fichier
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function previewProject() {
            const title = document.querySelector('[name="project[title]"]').value;
            const description = document.querySelector('[name="project[description]"]').value;
            const fullDescription = document.querySelector('[name="project[fullDescription]"]').value;
            const mainImageCount = document.getElementById('mainImageCount').textContent;
            const galleryCount = document.getElementById('galleryImageCount').textContent;

            if (!title.trim()) {
                alert('Veuillez saisir un titre pour prévisualiser le projet');
                return;
            }

            // Ouvrir une popup de preview améliorée
            const previewWindow = window.open('', '_blank', 'width=900,height=700');
            previewWindow.document.write(`
                <html>
                    <head>
                        <title>Aperçu - ${title}</title>
                        <style>
                            body {
                                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                                padding: 30px;
                                max-width: 800px;
                                margin: 0 auto;
                                background: #f8f9fa;
                            }
                            .container {
                                background: white;
                                padding: 30px;
                                border-radius: 10px;
                                box-shadow: 0 0 20px rgba(0,0,0,0.1);
                            }
                            h1 {
                                color: #007bff;
                                margin-bottom: 20px;
                                font-size: 2em;
                            }
                            .preview-note {
                                background: #fff3cd;
                                padding: 15px;
                                border-radius: 5px;
                                margin-bottom: 25px;
                                border-left: 4px solid #ffc107;
                            }
                            .section {
                                margin-bottom: 25px;
                                padding-bottom: 20px;
                                border-bottom: 1px solid #e9ecef;
                            }
                            .label {
                                font-weight: 600;
                                color: #6c757d;
                                margin-bottom: 8px;
                            }
                            .image-stats {
                                display: flex;
                                gap: 20px;
                                margin-top: 20px;
                            }
                            .stat {
                                background: #f8f9fa;
                                padding: 10px 20px;
                                border-radius: 5px;
                                text-align: center;
                            }
                            .stat-number {
                                font-size: 1.5em;
                                font-weight: bold;
                                color: #007bff;
                            }
                        </style>
                    </head>
                    <body>
                        <div class="container">
                            <div class="preview-note">
                                <strong>🔍 Aperçu du projet</strong><br>
                                <small>Ceci est un aperçu rapide de votre projet avant enregistrement</small>
                            </div>

                            <h1>${title}</h1>

                            <div class="section">
                                <div class="label">Description courte :</div>
                                <p>${description || '<em>Aucune description courte</em>'}</p>
                            </div>

                            <div class="section">
                                <div class="label">Description complète :</div>
                                <p>${fullDescription || '<em>Aucune description complète</em>'}</p>
                            </div>

                            <div class="image-stats">
                                <div class="stat">
                                    <div class="stat-number">${mainImageCount}</div>
                                    <small>Image principale</small>
                                </div>
                                <div class="stat">
                                    <div class="stat-number">${galleryCount}</div>
                                    <small>Images de galerie</small>
                                </div>
                            </div>
                        </div>
                    </body>
                </html>
            `);
        }
    </script>

    <style>
        .project-sidebar {
            top: 100px;
        }

        .gallery-section {
            border: 2px dashed #dee2e6;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .gallery-item {
            position: relative;
            border-radius: 5px;
            overflow: hidden;
            background: #f8f9fa;
            aspect-ratio: 1;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .gallery-item-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
            color: white;
            padding: 5px;
            font-size: 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .images-counter {
            border: 1px solid #bee5eb;
        }

        .skills-section .form-check {
            background: #f8f9fa;
            padding: 8px 12px;
            border-radius: 5px;
            margin-bottom: 5px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }

        .skills-section .form-check:hover {
            background: #e9ecef;
            border-color: #dee2e6;
        }

        .skills-section .form-check-input:checked + .form-check-label {
            font-weight: 500;
            color: #007bff;
        }

        .form-actions {
            background: #f8f9fa;
            margin: 0 -1.5rem -1.5rem;
            padding: 1rem 1.5rem;
            border-radius: 0 0 .375rem .375rem;
        }

        @media (max-width: 768px) {
            .gallery-grid {
                grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            }
        }
    </style>
{% endblock %}
