{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('admin_projects') }}">Projets</a></li>
    <li class="breadcrumb-item active">{{ project.title }}</li>
{% endblock %}

{% block admin_content %}
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            {% if project.image %}
                                <img src="{{ asset('uploads/projects/' ~ project.image) }}"
                                     alt="{{ project.title }}"
                                     class="rounded me-3"
                                     style="width: 50px; height: 50px; object-fit: cover;">
                            {% endif %}
                            <div>
                                <h5 class="mb-0">Modifier {{ project.title }}</h5>
                                <small class="text-muted">
                                    <i class="fas fa-eye me-1"></i>{{ project.viewCount }} vues
                                    • Créé le {{ project.createdAt|date('d/m/Y') }}
                                </small>
                            </div>
                        </div>

                        <div class="btn-group">
                            <a href="{{ path('app_project_show', {id: project.id}) }}"
                               class="btn btn-outline-info btn-sm"
                               target="_blank">
                                <i class="fas fa-external-link-alt me-1"></i>Voir
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                {{ form_row(form.title) }}
                            </div>

                            <div class="mb-3">
                                {{ form_row(form.description) }}
                            </div>

                            <div class="mb-4">
                                {{ form_row(form.fullDescription) }}
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="project-sidebar bg-light p-3 rounded">
                                <h6 class="mb-3">
                                    <i class="fas fa-image me-2"></i>Image du projet
                                </h6>

                                {% if project.image %}
                                    <div class="current-image mb-3">
                                        <img src="{{ asset('uploads/projects/' ~ project.image) }}"
                                             class="img-fluid rounded"
                                             alt="{{ project.title }}">
                                        <small class="text-muted d-block mt-1">Image actuelle</small>
                                    </div>
                                {% endif %}

                                <div class="mb-3">
                                    {{ form_row(form.imageFile) }}
                                </div>

                                <div class="image-preview mb-3" id="imagePreview" style="display: none;">
                                    <img id="previewImg" class="img-fluid rounded" alt="Aperçu">
                                    <small class="text-muted d-block mt-1">Nouvelle image</small>
                                </div>

                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Laisser vide pour conserver l'image actuelle
                                </small>
                            </div>

                            <!-- Project Stats -->
                            <div class="project-stats mt-3 p-3 bg-white border rounded">
                                <h6 class="mb-3">
                                    <i class="fas fa-chart-bar me-2"></i>Statistiques
                                </h6>
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="stat-item">
                                            <div class="stat-value text-primary">{{ project.viewCount }}</div>
                                            <div class="stat-label">Vues</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-item">
                                            <div class="stat-value text-success">{{ project.skills|length }}</div>
                                            <div class="stat-label">Technologies</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="skills-section">
                                <h6 class="mb-3">
                                    <i class="fas fa-star me-2"></i>Technologies utilisées
                                </h6>
                                {{ form_row(form.skills) }}
                            </div>
                        </div>
                    </div>

                    <div class="form-actions d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <div>
                            <a href="{{ path('admin_projects') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                        </div>

                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-danger" onclick="resetViewCount()">
                                <i class="fas fa-undo me-2"></i>Reset vues
                            </button>
                            {{ form_row(form.submit, {'attr': {'class': 'btn btn-success'}}) }}
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Preview image
            const imageInput = document.querySelector('input[type="file"]');
            const imagePreview = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');

            if (imageInput) {
                imageInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            previewImg.src = e.target.result;
                            imagePreview.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    } else {
                        imagePreview.style.display = 'none';
                    }
                });
            }
        });

        function resetViewCount() {
            if (confirm('Êtes-vous sûr de vouloir remettre le compteur de vues à zéro ?')) {
                // Ajouter un champ caché pour signaler le reset
                const form = document.querySelector('form');
                const resetInput = document.createElement('input');
                resetInput.type = 'hidden';
                resetInput.name = 'reset_views';
                resetInput.value = '1';
                form.appendChild(resetInput);

                alert('Le compteur sera remis à zéro lors de la sauvegarde');
            }
        }
    </script>

    <style>
        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
{% endblock %}
