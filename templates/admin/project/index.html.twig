{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des projets{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Projets</li>
{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2">
                <i class="fas fa-folder text-primary me-2"></i>
                Gestion des projets
            </h1>
            <p class="text-muted mb-0">Créez et gérez vos projets portfolio</p>
        </div>

        <div>
            <a href="{{ path('admin_project_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Nouveau projet
            </a>
        </div>
    </div>

    <!-- Projects Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card bg-primary text-white">
                <div class="stats-content">
                    <h3>{{ projects|length }}</h3>
                    <p>Projets total</p>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-folder"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-success text-white">
                <div class="stats-content">
                    <h3>{{ projects|reduce((carry, project) => carry + project.viewCount, 0) }}</h3>
                    <p>Vues totales</p>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-eye"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-info text-white">
                <div class="stats-content">
                    <h3>{{ projects|filter(p => p.createdAt > date().modify('first day of this month'))|length }}</h3>
                    <p>Ce mois-ci</p>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-calendar"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-warning text-white">
                <div class="stats-content">
                    <h3>{{ (projects|reduce((carry, project) => carry + project.viewCount, 0) / (projects|length > 0 ? projects|length : 1))|round }}</h3>
                    <p>Vues moyennes</p>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Projects Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">Liste des projets</h5>
                </div>
                <div class="col-auto">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary active">
                            <i class="fas fa-list"></i> Liste
                        </button>
                        <button class="btn btn-outline-secondary">
                            <i class="fas fa-th-large"></i> Grille
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            {% if projects %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Projet</th>
                            <th>Compétences</th>
                            <th>Vues</th>
                            <th>Créé le</th>
                            <th width="150">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for project in projects %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="project-thumbnail me-3">
                                            {% if project.image %}
                                                <img src="{{ asset('uploads/projects/' ~ project.image) }}"
                                                     alt="{{ project.title }}"
                                                     class="rounded"
                                                     style="width: 50px; height: 50px; object-fit: cover;">
                                            {% else %}
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                     style="width: 50px; height: 50px;">
                                                    <i class="fas fa-image text-muted"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div>
                                            <h6 class="mb-1">{{ project.title }}</h6>
                                            <small class="text-muted">
                                                {{ project.description|length > 50 ?
                                                project.description|slice(0, 50) ~ '...' :
                                                project.description }}
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="skill-tags">
                                        {% for skill in project.skill|slice(0, 3) %}
                                            <span class="badge bg-light text-dark me-1">{{ skill.name }}</span>
                                        {% endfor %}
                                        {% if project.skill|length > 3 %}
                                            <span class="badge bg-secondary">+{{ project.skill|length - 3 }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        <i class="fas fa-eye me-1"></i>{{ project.viewCount }}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">{{ project.createdAt|date('d/m/Y') }}</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_project_show', {id: project.id}) }}"
                                           class="btn btn-outline-info"
                                           target="_blank"
                                           title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_project_edit', {id: project.id}) }}"
                                           class="btn btn-outline-primary"
                                           title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post"
                                              action="{{ path('admin_project_delete', {id: project.id}) }}"
                                              style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                            <button class="btn btn-outline-danger"
                                                    title="Supprimer"
                                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce projet ?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Aucun projet</h5>
                    <p class="text-muted mb-4">Commencez par créer votre premier projet</p>
                    <a href="{{ path('admin_project_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Créer un projet
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .stats-card {
            border-radius: 15px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .stats-content h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stats-content p {
            margin: 0;
            opacity: 0.9;
        }

        .stats-icon {
            font-size: 2rem;
            opacity: 0.7;
        }
    </style>
{% endblock %}
