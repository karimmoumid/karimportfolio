{% extends 'admin/base.html.twig' %}

{% block title %}Message de {{ message.senderName }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('admin_messages') }}">Messages</a></li>
    <li class="breadcrumb-item active">{{ message.subject }}</li>
{% endblock %}

{% block admin_content %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="message-detail">
                <!-- Message Header -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="message-info">
                                <h4 class="mb-2">{{ message.subject }}</h4>
                                <div class="message-meta">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="sender-avatar me-3">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 50px; font-weight: 600;">
                                                {{ message.senderName|slice(0,1)|upper }}
                                            </div>
                                        </div>
                                        <div>
                                            <strong>{{ message.senderName }}</strong>
                                            {% if message.company %}
                                                <span class="text-muted">de {{ message.company }}</span>
                                            {% endif %}
                                            <br>
                                            <a href="mailto:{{ message.senderEmail }}" class="text-decoration-none">
                                                {{ message.senderEmail }}
                                            </a>
                                        </div>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        Reçu le {{ message.createdAt|date('d/m/Y à H:i') }}
                                        {% if message.readAt %}
                                            • Lu le {{ message.readAt|date('d/m/Y à H:i') }}
                                        {% endif %}
                                    </small>
                                </div>
                            </div>

                            <div class="message-actions">
                                <div class="btn-group">
                                    <a href="mailto:{{ message.senderEmail }}?subject=Re: {{ message.subject }}"
                                       class="btn btn-success">
                                        <i class="fas fa-reply me-2"></i>Répondre
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_message_delete', {id: message.id}) }}"
                                          style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.id) }}">
                                        <button class="btn btn-outline-danger"
                                                onclick="return confirm('Confirmer la suppression de ce message ?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="message-content">
                            <div class="content-wrapper">
                                {{ message.content|nl2br }}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Response -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="fas fa-paper-plane me-2"></i>
                            Réponse rapide
                        </h6>
                    </div>
                    <div class="card-body">
                        <form action="mailto:{{ message.senderEmail }}" method="get">
                            <input type="hidden" name="subject" value="Re: {{ message.subject }}">

                            <div class="mb-3">
                                <label class="form-label">Message de réponse</label>
                                <textarea name="body" class="form-control" rows="6" placeholder="Votre réponse...">Bonjour {{ message.senderName }},

Merci pour votre message concernant "{{ message.subject }}".

Je vous recontacte très prochainement pour discuter de votre projet.

Cordialement,
Karim MOUMID</textarea>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="{{ path('admin_messages') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Retour aux messages
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane me-2"></i>Ouvrir dans le client email
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0">Informations de contact</h6>
                </div>
                <div class="card-body">
                    <div class="contact-detail">
                        <div class="mb-3">
                            <label class="text-muted small">Nom complet</label>
                            <p class="mb-0">{{ message.senderName }}</p>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Email</label>
                            <p class="mb-0">
                                <a href="mailto:{{ message.senderEmail }}">{{ message.senderEmail }}</a>
                            </p>
                        </div>

                        {% if message.company %}
                            <div class="mb-3">
                                <label class="text-muted small">Entreprise</label>
                                <p class="mb-0">{{ message.company }}</p>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label class="text-muted small">Date de réception</label>
                            <p class="mb-0">{{ message.createdAt|date('d/m/Y à H:i') }}</p>
                        </div>

                        <div class="mb-0">
                            <label class="text-muted small">Statut</label>
                            <p class="mb-0">
                                {% if message.readAt %}
                                    <span class="badge bg-success">
                                    <i class="fas fa-check me-1"></i>Lu
                                </span>
                                {% else %}
                                    <span class="badge bg-warning">
                                    <i class="fas fa-envelope me-1"></i>Non lu
                                </span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions rapides -->
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white">
                    <h6 class="mb-0">Actions rapides</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="mailto:{{ message.senderEmail }}?subject=Re: {{ message.subject }}"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-reply me-2"></i>Répondre par email
                        </a>
                        <a href="tel:+33751953339" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-phone me-2"></i>Proposer un appel
                        </a>
                        <button class="btn btn-outline-info btn-sm" onclick="copyEmail()">
                            <i class="fas fa-copy me-2"></i>Copier l'email
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function copyEmail() {
            navigator.clipboard.writeText('{{ message.senderEmail }}');

            // Feedback visuel
            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check me-2"></i>Copié !';
            btn.classList.remove('btn-outline-info');
            btn.classList.add('btn-success');

            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-info');
            }, 2000);
        }
    </script>

    <style>
        .message-content {
            font-size: 1rem;
            line-height: 1.6;
            color: #495057;
        }

        .content-wrapper {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #007bff;
        }

        .sender-avatar {
            position: relative;
        }

        .contact-detail label {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
{% endblock %}
