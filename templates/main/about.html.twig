{% extends 'base.html.twig' %}

{% block title %}À propos - {{ parent() }}{% endblock %}

{% block body %}
    <!-- Header Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="display-4 fw-bold text-primary mb-3">À propos de moi</h1>
                    <p class="lead text-muted">
                        Découvrez mon parcours et ma passion pour le développement web
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Content -->
    <section class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 mb-4">
                    <div class="text-center">
                        <div class="avatar-large bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-4"
                             style="width: 200px; height: 200px; border-radius: 50%; font-size: 4rem; font-weight: 700;">
                            KM
                        </div>
                        <h3 class="text-primary">Karim MOUMID</h3>
                        <p class="text-muted">Développeur Full-Stack</p>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="about-content">
                        <h2 class="h3 mb-4">Mon Parcours</h2>
                        <p class="mb-4">
                            Passionné par les nouvelles technologies et le développement web, j'ai entamé une
                            reconversion professionnelle vers le développement après plusieurs années d'expérience
                            dans le domaine de la qualité au sein du groupe <strong>BIOGROUP</strong>.
                        </p>

                        <p class="mb-4">
                            Actuellement en formation <strong>Développeur Web et Web Mobile</strong> à l'EEDN,
                            je me spécialise dans les technologies modernes comme <strong>Symfony</strong>,
                            <strong>PHP 8.4</strong>, <strong>JavaScript ES6+</strong> et <strong>Docker</strong>.
                        </p>

                        <h3 class="h4 mb-3">Ce qui me motive</h3>
                        <ul class="list-unstyled mb-4">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Créer des applications web performantes et intuitives</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Résoudre des problèmes complexes avec des solutions élégantes</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Apprendre continuellement les nouvelles technologies</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Collaborer en équipe sur des projets innovants</li>
                        </ul>

                        <div class="d-flex gap-3 flex-wrap">
                            <a href="{{ path('app_projects') }}" class="btn btn-primary">
                                <i class="fas fa-folder me-2"></i>Voir mes projets
                            </a>
                            <a href="{{ path('app_contact') }}" class="btn btn-outline-primary">
                                <i class="fas fa-envelope me-2"></i>Me contacter
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experience & Formation -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <h2 class="h3 mb-4">
                        <i class="fas fa-graduation-cap text-primary me-2"></i>Formation
                    </h2>

                    <div class="timeline-item mb-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h4 class="card-title h5">Développeur Web et Web Mobile</h4>
                                <p class="text-primary mb-2">EEDN - École Européenne des Nouvelles Technologies</p>
                                <p class="text-muted mb-2">2024 - 2025</p>
                                <p class="card-text">
                                    Formation intensive en développement web moderne : Symfony, PHP, JavaScript,
                                    base de données, méthodes agiles, travail en équipe.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mb-4">
                    <h2 class="h3 mb-4">
                        <i class="fas fa-briefcase text-primary me-2"></i>Expérience
                    </h2>

                    <div class="timeline-item mb-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h4 class="card-title h5">Technicien Qualité</h4>
                                <p class="text-primary mb-2">BIOGROUP</p>
                                <p class="text-muted mb-2">2020 - 2024</p>
                                <p class="card-text">
                                    Gestion de la qualité, analyse de processus, rigueur méthodologique.
                                    Compétences transférables vers le développement : analyse, résolution
                                    de problèmes, attention aux détails.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item mb-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h4 class="card-title h5">Stage Qualité</h4>
                                <p class="text-primary mb-2">LENAJA</p>
                                <p class="text-muted mb-2">2019</p>
                                <p class="card-text">
                                    Première expérience professionnelle dans le domaine de la qualité
                                    et de l'analyse de processus.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-5 bg-primary text-white">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-8">
                    <h2 class="mb-3">Intéressé par mon profil ?</h2>
                    <p class="lead mb-4">
                        N'hésitez pas à me contacter pour discuter de vos projets ou opportunités !
                    </p>
                    <a href="{{ path('app_contact') }}" class="btn btn-light btn-lg">
                        <i class="fas fa-comments me-2"></i>Entrons en contact
                    </a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
