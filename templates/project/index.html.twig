{% extends 'base.html.twig' %}

{% block title %}Mes Projets - {{ parent() }}{% endblock %}

{% block body %}
    <!-- Header Section -->
    <section class="py-5 bg-light" role="region" aria-labelledby="projects-header-title">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 id="projects-header-title" class="display-4 fw-bold text-primary mb-3">Mes Projets</h1>
                    <p class="lead text-muted">
                        Découvrez une sélection de mes réalisations en développement web
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Filters Section -->
    <section class="py-4 bg-white border-bottom" role="search" aria-label="Filtres de recherche de projets">
        <div class="container">
            <form method="GET" id="projectFilters" aria-describedby="filters-instructions">
                <p id="filters-instructions" class="visually-hidden">
                    Vous pouvez rechercher un projet par nom, description ou filtrer par technologie.
                </p>
                <div class="row align-items-end g-3">
                    <div class="col-lg-6">
                        <label for="search" class="form-label">Rechercher un projet</label>
                        <input type="search"
                               name="search"
                               id="search"
                               class="form-control form-control-lg"
                               placeholder="Rechercher par titre ou description..."
                               value="{{ currentSearch }}"
                               aria-label="Rechercher un projet par titre ou description">
                    </div>
                    <div class="col-lg-4">
                        <label for="skill" class="form-label">Filtrer par technologie</label>
                        <select name="skill" id="skill" class="form-select form-select-lg" aria-label="Filtrer les projets par technologie utilisée">
                            <option value="">Toutes les technologies</option>
                            {% for skill in skills %}
                                <option value="{{ skill.name }}" {{ currentSkill == skill.name ? 'selected' : '' }}>
                                    {{ skill.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100" aria-label="Lancer la recherche">
                            <i class="fas fa-search" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <!-- Projects Grid -->
    <section class="py-5" role="region" aria-labelledby="projects-grid-title">
        <div class="container">
            <h2 id="projects-grid-title" class="visually-hidden">Liste des projets disponibles</h2>

            {% if projects %}
                <div class="row g-4" id="projectsContainer" role="list">
                    {% for project in projects %}
                        <div class="col-lg-6 col-xl-4 mb-4" role="listitem">
                            <div class="card project-card h-100 border-0" role="article" aria-labelledby="project-title-{{ project.id }}">
                                <div class="project-image position-relative">
                                    {% if project.image %}
                                        <img src="{{ asset('uploads/projects/' ~ project.image) }}"
                                             class="card-img-top"
                                             alt="Image illustrant le projet {{ project.title }}"
                                             style="height: 250px; object-fit: cover;">
                                    {% else %}
                                        <div class="project-placeholder bg-light d-flex align-items-center justify-content-center"
                                             style="height: 250px;"
                                             role="img"
                                             aria-label="Icône de code représentant un projet sans image">
                                            <i class="fas fa-code fa-3x text-muted" aria-hidden="true"></i>
                                        </div>
                                    {% endif %}

                                    <div class="project-overlay">
                                        <a href="{{ path('app_project_show', {id: project.id}) }}"
                                           class="btn btn-primary btn-lg"
                                           aria-label="Voir les détails du projet {{ project.title }}">
                                            <i class="fas fa-eye me-2" aria-hidden="true"></i>Voir le projet
                                        </a>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <h3 id="project-title-{{ project.id }}" class="card-title h5 mb-3">
                                        <a href="{{ path('app_project_show', {id: project.id}) }}"
                                           class="text-decoration-none text-primary"
                                           aria-label="Accéder à la page du projet {{ project.title }}">
                                            {{ project.title }}
                                        </a>
                                    </h3>

                                    <p class="card-text text-muted mb-3">
                                        {{ project.description|length > 120 ?
                                        project.description|slice(0, 120) ~ '...' :
                                        project.description }}
                                    </p>

                                    <div class="project-skills mb-3" role="list" aria-label="Compétences utilisées dans le projet {{ project.title }}">
                                        {% for skill in project.skill|slice(0, 4) %}
                                            <span class="badge bg-light text-dark me-1 mb-1" role="listitem">
                                                {{ skill.name }}
                                            </span>
                                        {% endfor %}
                                        {% if project.skill|length > 4 %}
                                            <span class="badge bg-secondary mb-1" aria-label="et {{ project.skill|length - 4 }} autres compétences">
                                                +{{ project.skill|length - 4 }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted" aria-label="Nombre de vues : {{ project.viewCount }}">
                                            <i class="fas fa-eye me-1" aria-hidden="true"></i>{{ project.viewCount }} vues
                                        </small>
                                        <small class="text-muted" aria-label="Projet créé en {{ project.createdAt|date('M Y') }}">
                                            <i class="fas fa-calendar me-1" aria-hidden="true"></i>{{ project.createdAt|date('M Y') }}
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if projects|length == 0 %}
                    <div class="text-center py-5" role="alert" aria-live="polite">
                        <i class="fas fa-search fa-4x text-muted mb-4" aria-hidden="true"></i>
                        <h3 class="text-muted">Aucun projet trouvé</h3>
                        <p class="text-muted mb-4">
                            Aucun projet ne correspond à vos critères de recherche.
                        </p>
                        <a href="{{ path('app_projects') }}" class="btn btn-primary" aria-label="Réinitialiser les filtres de recherche">
                            <i class="fas fa-refresh me-2" aria-hidden="true"></i>Voir tous les projets
                        </a>
                    </div>
                {% endif %}
            {% else %}
                <div class="text-center py-5" role="alert" aria-live="polite">
                    <i class="fas fa-code fa-4x text-muted mb-4" aria-hidden="true"></i>
                    <h3 class="text-muted">Aucun projet disponible</h3>
                    <p class="text-muted">
                        Les projets seront bientôt disponibles !
                    </p>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('projectFilters');
            const searchInput = document.getElementById('search');
            const skillSelect = document.getElementById('skill');

            // Auto-submit form on skill change
            skillSelect.addEventListener('change', function() {
                form.submit();
            });

            // Submit form on search input with debounce
            let searchTimeout;
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    form.submit();
                }, 500);
            });
        });
    </script>
{% endblock %}
